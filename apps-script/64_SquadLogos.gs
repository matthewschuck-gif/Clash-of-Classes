/**
 * Clash of Classes -- Apps Script backend
 * File 64: the squad logos from the December Move, Make, Talk files (white line art on transparent),
 * as data URLs so they show anywhere without a separate image host. Used by Summit Party
 * (scoreboard, Chromebook page, winner banner). clashSquadLogos() hands them to a page once.
 */

const SQUAD_LOGOS_ = {
  BLACK: 'data:image/png;base64,',
  GOLD: 'data:image/png;base64,',
  GREY: 'data:image/png;base64,',
  PURPLE: 'data:image/png;base64,',
};

/** Public: the four squad logos (data URLs), keyed BLACK, GOLD, GREY, PURPLE. */
function clashSquadLogos() { return JSON.stringify(SQUAD_LOGOS_); }

